{
  "name": "cornerstone",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "apps": [
      "apps/*"
    ]
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "turbo": "^2.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "tsc --noEmit",
    "dev": "turbo dev",
    "dev:web": "pnpm --filter cornerstone-web dev",
    "dev:server": "pnpm --filter cornerstone-server dev",
    "start": "turbo start",
    "start:web": "pnpm --filter cornerstone-web start",
    "start:server": "pnpm --filter cornerstone-server start"
  },
  "dependencies": {
    "@colyseus/core": "^0.15.57",
    "@colyseus/ws-transport": "^0.15.3",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "fastify": "^5.12.7",
    "immer": "^11.1.21",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^3.20.0"
  }
}