# Server environment variables - REQUIRED for production
PORT=2567
# JWT_SECRET must be a strong random secret - never use the default!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-strong-secret-change-in-production
CORS_ORIGIN=https://your-frontend-domain.com

# Optional: comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Web environment variables (Vite)
VITE_SERVER_URL=wss://your-server-domain.com

# Optional game rules configuration (all optional, use defaults if omitted)
# RULES_STARTING_CASH=1500
# RULES_TURN_TIMER_SEC=30
# RULES_MAX_PLAYERS=6
# RULES_SUDDEN_GROWTH_ROUND=10