# Server environment variables - REQUIRED for production
PORT=2567
# JWT_SECRET must be a strong random secret - never use the default!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-strong-secret-change-in-production
CORS_ORIGIN=https://your-frontend-domain.com

# Optional: comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Supabase Cloud Database (Required for persistent accounts & cross-device sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Web environment variables (Vite)
VITE_SERVER_URL=wss://your-server-domain.com
VITE_POSTHOG_KEY=phc_your_posthog_project_api_key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional game rules configuration (all optional, use defaults if omitted)
# RULES_STARTING_CASH=1500
# RULES_TURN_TIMER_SEC=30
# RULES_MAX_PLAYERS=6
# RULES_SUDDEN_GROWTH_ROUND=10

# PhonePe Official Payment Gateway (RBI Authorized)
# Set PHONEPE_ENV to 'PRODUCTION' once your KYC is approved.
# For Sandbox testing, use Merchant ID: PGTESTPAYUAT
PHONEPE_ENV=SANDBOX
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
PHONEPE_SALT_INDEX=1
PHONEPE_CALLBACK_URL=http://localhost:2567/api/phonepe/callback
PHONEPE_REDIRECT_URL=http://localhost:3000
# In PRODUCTION, the host URL automatically switches to https://api.phonepe.com/apis/hermes
# PHONEPE_HOST_URL=https://api.phonepe.com/apis/hermes